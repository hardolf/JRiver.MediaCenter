<?xml version="1.0" encoding="utf-8"?>
<!--
Musixmatch API
http://www.musixmatch.com/
No user ID required
Token required, may be obtained from: https://developer.musixmatch.com/signup

See also: https://www.programmableweb.com/api/musixmatch
-->
<configuration>

    <!-- 
    The appSettings are only used during the first/initial startup.
    After the first/initial startup, the XML datafile is used for keeping the settings.
    The XML datafile location is defined in the "LyricsFinderCore.dll.config" configuration file, 
    in the "localAppDataFile" appSetting.
    Default XML datafile location:
    "%USERPROFILE%\Documents\LyricsFinder\LyricsFinder.xml" 
    -->
    <appSettings>
        <add key="Company" value="Musixmatch" />
        <add key="CreditTextFormat" value="  ----------------------------------------------------------- Found by LyricsFinder for JRiver MediaCenter on {Date} Lyrics found in {ServiceName} {Company} - {CreditUrl} {ServiceName} - {ServiceUrl} {Copyright} ----------------------------------------------------------- " />
        <add key="CreditUrl" value="https://www.musixmatch.com" />
        <add key="DateFormat" value="yyyy.MM.dd" />
        <add key="ServiceName" value="Musixmatch API" />
        <add key="ServiceUrl" value="http://api.musixmatch.com/ws/1.1" />
        <add key="Comment" value="No user ID required.  Token required, may be obtained from:  https://developer.musixmatch.com/signup.  Only the first 30% of found lyric text is returned under the free plan.  Paid plans are available." />
    </appSettings>

    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>

  <runtime>

    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">

      <dependentAssembly>

        <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />

        <bindingRedirect oldVersion="0.0.0.0-6.0.3.0" newVersion="6.0.3.0" />

      </dependentAssembly>

      <dependentAssembly>

        <assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />

        <bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0" />

      </dependentAssembly>

      <dependentAssembly>

        <assemblyIdentity name="System.Diagnostics.DiagnosticSource" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />

        <bindingRedirect oldVersion="0.0.0.0-10.0.0.2" newVersion="10.0.0.2" />

      </dependentAssembly>

      <dependentAssembly>

        <assemblyIdentity name="System.Collections.Immutable" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />

        <bindingRedirect oldVersion="0.0.0.0-10.0.0.2" newVersion="10.0.0.2" />

      </dependentAssembly>

      <dependentAssembly>

        <assemblyIdentity name="System.Reflection.Metadata" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />

        <bindingRedirect oldVersion="0.0.0.0-10.0.0.2" newVersion="10.0.0.2" />

      </dependentAssembly>

    </assemblyBinding>

  </runtime>
</configuration>
