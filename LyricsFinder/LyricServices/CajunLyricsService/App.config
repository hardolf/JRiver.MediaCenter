<?xml version="1.0" encoding="utf-8"?>
<!--
CajunLyrics Lyrics API
https://www.cajunlyrics.com/?page=api
No user ID or token required

See also: https://www.programmableweb.com/api/cajunlyrics-rest-api
-->
<configuration>

    <!-- 
    The appSettings are only used during the first/initial startup.
    After the first/initial startup, the XML datafile is used for keeping the settings.
    The XML datafile location is defined in the "LyricsFinderCore.dll.config" configuration file, 
    in the "localAppDataFile" appSetting.
    Default XML datafile location:
    "%USERPROFILE%\Documents\LyricsFinder\LyricsFinder.xml" 

    WARNING: a line break written literally inside an attribute value is replaced by a single
    space when the file is read (XML 1.0, section 3.3.3). A multi line value must therefore use
    the &#xD;&#xA; character references, the way CreditTextFormat does below.
    The alternative is to move the setting into a "lyricService" section as a child element,
    where a literal line break survives; there the continuation lines must start in column 1.
    -->
    <appSettings>
        <add key="Company" value="CajunLyrics" />
        <add key="CreditTextFormat" value="&#xD;&#xA;&#xD;&#xA;-----------------------------------------------------------&#xD;&#xA;Found by LyricsFinder for JRiver MediaCenter on {Date}&#xD;&#xA;Lyrics found in {ServiceName}&#xD;&#xA;{Company} - {CreditUrl}&#xD;&#xA;{ServiceName} - {ServiceUrl}&#xD;&#xA;-----------------------------------------------------------&#xD;&#xA;" />
        <add key="CreditUrl" value="https://www.cajunlyrics.com" />
        <add key="DateFormat" value="yyyy.MM.dd" />
        <add key="ServiceName" value="CajunLyrics" />
        <add key="ServiceUrl" value="http://api.cajunlyrics.com" />
        <add key="Comment" value="No user ID or token required." />
    </appSettings>

    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>

  <runtime>

